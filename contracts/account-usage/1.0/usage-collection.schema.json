{
  "$defs": {
    "UsageWindow": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "five_hour",
            "weekly",
            "seven_day",
            "weekly_scoped",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "modelScope": {
          "anyOf": [
            {
              "enum": [
                "opus",
                "sonnet",
                "haiku",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelscope"
        },
        "usedPercent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Usedpercent",
          "type": "number"
        },
        "remainingPercent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Remainingpercent",
          "type": "number"
        },
        "resetsAt": {
          "format": "date-time",
          "title": "Resetsat",
          "type": "string"
        },
        "windowDurationMins": {
          "exclusiveMinimum": 0,
          "maximum": 525600,
          "title": "Windowdurationmins",
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "event",
                "probe"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "receivedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receivedat"
        },
        "ageSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ageseconds"
        }
      },
      "required": [
        "kind",
        "usedPercent",
        "remainingPercent",
        "resetsAt",
        "windowDurationMins"
      ],
      "title": "UsageWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "runtime": {
      "enum": [
        "codex",
        "claude_code",
        "dsh"
      ],
      "title": "Runtime",
      "type": "string"
    },
    "accountKey": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accountkey"
    },
    "planType": {
      "anyOf": [
        {
          "enum": [
            "free",
            "plus",
            "pro",
            "max",
            "team",
            "business",
            "enterprise",
            "edu",
            "go"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plantype"
    },
    "errorCode": {
      "anyOf": [
        {
          "enum": [
            "unavailable",
            "rate_limited",
            "invalid_response",
            "account_changed",
            "account_unavailable",
            "unsupported_auth"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Errorcode"
    },
    "windows": {
      "items": {
        "$ref": "#/$defs/UsageWindow"
      },
      "maxItems": 32,
      "title": "Windows",
      "type": "array"
    },
    "fetchedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fetchedat"
    },
    "stale": {
      "default": true,
      "title": "Stale",
      "type": "boolean"
    },
    "nextAttemptAt": {
      "default": 0,
      "title": "Nextattemptat",
      "type": "number"
    }
  },
  "required": [
    "runtime"
  ],
  "title": "UsageCollection",
  "type": "object"
}
