{
  "$defs": {
    "ParseWarning": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^(\\$|windows|(?:five_hour|seven_day)(?:\\.(?:utilization|resets_at))?)$",
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "enum": [
            "TypeError",
            "ValueError",
            "OverflowError",
            "MissingField",
            "JSONDecodeError",
            "SizeLimit"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "title": "ParseWarning",
      "type": "object"
    },
    "UsageWindow": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "five_hour",
            "weekly",
            "seven_day",
            "weekly_scoped",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "modelScope": {
          "anyOf": [
            {
              "enum": [
                "opus",
                "sonnet",
                "haiku",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelscope"
        },
        "usedPercent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Usedpercent",
          "type": "number"
        },
        "remainingPercent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Remainingpercent",
          "type": "number"
        },
        "resetsAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resetsat"
        },
        "windowDurationMins": {
          "exclusiveMinimum": 0,
          "maximum": 525600,
          "title": "Windowdurationmins",
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "event",
                "probe"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "receivedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receivedat"
        },
        "ageSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ageseconds"
        }
      },
      "required": [
        "kind",
        "usedPercent",
        "remainingPercent",
        "resetsAt",
        "windowDurationMins"
      ],
      "title": "UsageWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "runtime": {
      "enum": [
        "codex",
        "claude_code",
        "dsh"
      ],
      "title": "Runtime",
      "type": "string"
    },
    "accountKey": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accountkey"
    },
    "planType": {
      "anyOf": [
        {
          "enum": [
            "free",
            "plus",
            "pro",
            "max",
            "team",
            "business",
            "enterprise",
            "edu",
            "go"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plantype"
    },
    "errorCode": {
      "anyOf": [
        {
          "enum": [
            "unavailable",
            "rate_limited",
            "invalid_response",
            "account_changed",
            "account_unavailable",
            "unsupported_auth",
            "auth_expired",
            "parse_error"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Errorcode"
    },
    "parseWarnings": {
      "items": {
        "$ref": "#/$defs/ParseWarning"
      },
      "maxItems": 8,
      "title": "Parsewarnings",
      "type": "array"
    },
    "detail": {
      "anyOf": [
        {
          "pattern": "^(write_failed_after_refresh|(?:\\$|windows|(?:five_hour|seven_day)(?:\\.(?:utilization|resets_at))?): (?:TypeError|ValueError|OverflowError|MissingField|JSONDecodeError|SizeLimit)(?:; (?:\\$|windows|(?:five_hour|seven_day)(?:\\.(?:utilization|resets_at))?): (?:TypeError|ValueError|OverflowError|MissingField|JSONDecodeError|SizeLimit))*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "windows": {
      "items": {
        "$ref": "#/$defs/UsageWindow"
      },
      "maxItems": 2,
      "title": "Windows",
      "type": "array"
    },
    "retryAfterSeconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retryafterseconds"
    },
    "retryAfterAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retryafterat"
    }
  },
  "required": [
    "runtime"
  ],
  "title": "ClaudeProbeResult",
  "type": "object"
}
